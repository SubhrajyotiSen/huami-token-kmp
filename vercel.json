{
  "buildCommand": "./gradlew :web:jsBrowserDistribution",
  "outputDirectory": "web/build/dist/js/productionExecutable",
  "regions": ["iad1"],
  "functions": {
    "api/proxy.js": { "maxDuration": 15 }
  },
  "rewrites": [
    {
      "source": "/api/proxy",
      "destination": "/api/proxy.js"
    }
  ]
}
